#ifndef AVOID_H
#define AVOID_H

// 超声波避障状态机
//
// ==================== 动作序列 ====================
// （以"障碍物在右侧"为例，车本来在线上正常循迹）
//
//   FOLLOW    循迹中持续测距
//     |  任一侧探头【连续 AVOID_CONFIRM 次】都读到 <= AVOID_TRIGGER_CM
//     v
//   BRAKE     刹停（防惯性蹭上去，比赛要求零接触）
//     |
//     v
//   DODGE     转出：障碍侧轮停、另一侧轮快 -> 车头偏离原方向 AVOID_DODGE_DEG
//     |
//     v
//   PASS      两轮同速直行（AVOID_PASS_PULSES，当前 15cm），越过障碍物
//     |
//     v
//   BACKTURN  反向原地转 (45° + AVOID_APPROACH_DEG) —— 抵消刚才的转出，
//     |       再多转 AVOID_APPROACH_DEG，于是车头斜对着循迹线
//     |       ⚠ 这一步【同时盯着循迹传感器】：转到半路压到线就立刻
//     |         刹停"抓住"（CAPTURE），不再闭着眼睛转满角度。
//     |         这一步很关键：转完才去看线的话，线早从传感器下面扫过去了。
//     v
//   CAPTURE   刹停抓住：停稳后线还在 -> 直接交回循迹（车停在线上了）；
//     |       线不在（刚才是毛刺）-> 按当前斜角继续爬回去
//     v
//   APPROACH  两轮同速，沿这个斜角直线朝线爬，
//     |       直到循迹传感器压到线（连续确认）
//     v
//   FOLLOW    交回循迹。车头歪角不大，循迹来得及对正
//
//   （APPROACH 爬够 AVOID_APPROACH_MAX_PULSES 还没看到线
//     -> 退化成 SWEEP：慢速画弧一直扫，绝不主动停车）
//
// ==================== 为什么不能用"画弧直接拐回线上" ====================
// （上一版就是这么写的，实测必然失败）
//   圆弧是对称的：以 45° 离开线，就一定以 45° 撞回线上 ——
//   车是"斜着扎过线"的。而循迹的位置环只看得见"线在车身下的左右偏移"，
//   看不见车头朝向；等它反应过来，车已经冲过线又丢了，接着就是原地转圈找线。
//   现象就是：绕完障碍一路直着冲出去，再也回不来。
//   所以必须先用编码器把车头转正，再用一个小角度斜着爬回来。
//
// ==================== 使用约定（必须遵守，否则会互相干扰）====================
//   1. 本模块【只在主循环】调用，绝不进中断。
//   2. 本模块【不调用任何 Track_xxx 函数】——那些函数会操作 CD4051 的地址线，
//      和 TIM1 中断抢 GPIO，会让循迹读数错乱。循迹状态只读 g_track_active 副本。
//   3. 电机由 Avoid_ApplyMotion() 写，且必须由 main.c 在
//      __disable_irq() / __enable_irq() 之间调用，保证左右轮整组指令原子生效。
//   4. main.c 的中断里必须维护 g_track_active（压线路数副本），
//      且读编码器必须在 g_track_enable 判断【之前】。

#include "main.h"
#include "hcsr04.h"

/* ==================== 探头配置 ==================== */
/* 是否使用中间的 U2 探头（当前没装，保持 0） */
#define AVOID_USE_CENTER 0

/* ==================== 避障总开关（做对照实验用） ==================== */
/* 0 = 只循迹，完全不避障
 * 1 = 正常启用避障
 *
 * 想确认"车抽/车停"是不是避障造成的，就设成 0 烧一次：
 * 跑得顺说明问题在避障；还是抽说明问题在循迹/电机/供电上，与这段无关。 */
#define AVOID_ENABLE 1

/* ==================== 阈值（厘米） ==================== */
#define AVOID_TRIGGER_CM 25   /* 任一侧 <= 此距离 -> 触发避障 */

/* 触发确认：同一个探头【连续 AVOID_CONFIRM 次】都读到 <= 阈值才算真障碍。
 * 超声波偶尔会蹦假回波（电机 EMI、线长、共用电源都会引起），
 * 一次假读数就让车拐出去，看着就是"莫名其妙摆一下"。 */
#define AVOID_CONFIRM      2

/* 有效距离下限：小于 4cm 的读数当成盲区毛刺，不算数（HC-SR04 盲区 2~4cm）。
 * 驱动把"回波特别短"统一上报成 2cm，不滤掉的话一次毛刺就会触发避障。 */
#define AVOID_MIN_VALID_CM 4

/* "压到线了"的确认次数：传感器连续这么多拍压线才算真的回到线上，
 * 防止擦一下就交回循迹（交回太早、车头还歪着，就会丢线）。 */
#define AVOID_LINE_CONFIRM 3

/* ==================== 回正期间的"抓线"（CAPTURE） ==================== */
/* 回正是一边转一边扫线的：转过某个角度时传感器会横扫过线。
 * 一旦（连续 AVOID_CAPTURE_CONFIRM 拍）扫到线，就立刻刹停抓住它 ——
 * 不这样做的话，等转完再去看，线已经从传感器下面扫过去了。 */
#define AVOID_CAPTURE_CONFIRM 2    /* 抓线的确认拍数（比 LINE_CONFIRM 松一点，
                                    * 因为转头时线在传感器下停留时间短；
                                    * 抓到之后 CAPTURE 阶段还会再验一次） */
#define AVOID_CAPTURE_MS      120  /* 抓住后刹停保持时间；停稳线还在才算真抓到 */

/* "循迹但减速"这个中间状态：默认【关闭】。
 * 不建议开：正常行驶时读数在门槛附近波动会让 g_target_speed 来回跳，
 * 车一窜一窜的。只有确认正常读数稳定在 80cm 以上才建议改成 1。 */
#define AVOID_USE_SLOW     0
#define AVOID_SLOW_IN_CM   30
#define AVOID_SLOW_OUT_CM  45

/* ==================== 触发冷却（毫秒） ==================== */
/* 一次避障动作做完、交回循迹之后，这段时间内不再触发。
 * 目的：绕完回到线上时车往往还贴着障碍物，不冷却就会"刚回线又立刻刹车"，
 *       看起来就是走一段停一下、反反复复。
 * 调法：还反复触发 -> 调大（1200~1500）；漏检第二个障碍 -> 调小（600）。 */
#define AVOID_REARM_MS     1000

/* ==================== 采样周期（毫秒） ==================== */
/* 两路轮流测，所以单路约 2 倍这个时间刷新一次 */
#define AVOID_SAMPLE_MS 40

/* ==================== 角度 / 里程参数 ==================== */
/* 换算依据：轮径 48mm -> 周长 15.08cm；1040 脉冲/圈 -> 69 脉冲/cm；
 *           轮距 15cm -> 车身转 1° 约 18 脉冲。
 * 若以后换轮子或改减速比，按上面两条重新算。 */
#define AVOID_PULSES_PER_DEG 18   /* 车身转 1° 对应的车轮脉冲数 */

#define AVOID_DODGE_DEG      25   /* 转出角度：车头偏离原方向多少度。
                                   * 调小 -> 车离线的横向距离小，回正时传感器
                                   *         更容易扫到线、抓到线时车头也更平；
                                   *         但绕过障碍时车尾的余量也变小。
                                   * 调大 -> 绕障余量大，但横向偏移大、回线更难。 */
#define AVOID_APPROACH_DEG   30   /* 回线时车头与线的夹角（也就是"回正"要多转的度数）。
                                   * 调大 = 回正转得更多、车头更斜地扎向线、
                                   *        爬回线的距离更短，但对正的时间窗更短。
                                   * 调小 = 车头更接近平行、更好对正，但爬行距离更长。
                                   * 建议范围 20 ~ 35，不要超过 40。 */

#define AVOID_DODGE_PULSES    (AVOID_DODGE_DEG * AVOID_PULSES_PER_DEG)                        /* 450  = 25° */
#define AVOID_BACKTURN_PULSES ((AVOID_DODGE_DEG + AVOID_APPROACH_DEG) * AVOID_PULSES_PER_DEG)  /* 990  = 55° */
#define AVOID_PASS_PULSES     1035       /* 直行 15cm（69 脉冲/cm）：越过障碍物。
                                          * 调大 -> 车尾离障碍物更远，但横向偏移变大、
                                          *         回线要爬更久。 */
#define AVOID_APPROACH_MAX_PULSES 2400   /* 爬 35cm 还没看到线：说明这一趟方向偏了
                                          * （比如打滑导致实际转角没到位，直着爬根本
                                          *  碰不到线），立刻退化成兜底画弧扫线去扫它。
                                          * 不要设得太大 —— 直着爬再远也不会碰到线，
                                          * 只是白白跑掉赛道。 */

/* ==================== 各阶段电机 PWM（占空比 0~100） ==================== */
/* 注意：这组 PWM 不要一味往大调。如果轮胎打滑，PWM 越大越打滑、车越不转。 */
/* ⚠ 这组 PWM 不要一味往大调。如果轮胎打滑，PWM 越大越打滑、车越不转。 */
#define AVOID_DODGE_FAST    60    /* 转出：在转的那个轮子 */
#define AVOID_BACKTURN_PWM  45    /* 回正：比转出慢一点。
                                   * 转得慢，线在传感器下面停留更久，更容易抓到。 */
#define AVOID_DODGE_SLOW     0    /* 转出 / 回正：内侧轮（0 = 停住，转弯半径最小） */
#define AVOID_PASS_PWM     30     /* 直行绕过：两轮同速 */
#define AVOID_APPROACH_PWM 30     /* 斜着爬回线：两轮同速 */

/* ==================== 兜底扫线（绝不主动停车） ==================== */
/* 分两段：先用温和差速画弧，一段时间还没找到就加大差速继续找。
 * 比赛里停下就等于放弃，宁可一直画弧找线。 */
#define AVOID_SWEEP_FAST   45
#define AVOID_SWEEP_SLOW   20
#define AVOID_SWEEP_FAST2  55
#define AVOID_SWEEP_SLOW2   8
#define AVOID_SWEEP_MS     1500   /* 第一段的时长，之后切第二段（更急） */

/* ==================== 超时兜底（毫秒） ==================== */
#define AVOID_BRAKE_MS        60   /* 刹停保持时间 */
#define AVOID_DODGE_MAX_MS    1500
#define AVOID_PASS_MAX_MS     1500
#define AVOID_BACKTURN_MAX_MS 1200

/* ==================== 动作枚举 ==================== */
/* 上半部分是"循迹自己能处理"的，下半部分是"避障接管电机"的。
 * main.c 只需要判断 FOLLOW / SLOW 两个值，其余交给 Avoid_ApplyMotion()。 */
typedef enum
{
    AVOID_FOLLOW = 0,   /* 交还给寻迹逻辑（正常循迹） */
    AVOID_SLOW,         /* 循迹，但降低目标速度 */
    AVOID_BRAKE,        /* 避障：刹停 */
    AVOID_DODGE,        /* 避障：转出 45° */
    AVOID_PASS,         /* 避障：直行绕过 */
    AVOID_BACKTURN,     /* 避障：反向转 65°，车头斜对着线 */
    AVOID_CAPTURE,      /* 避障：回正途中扫到线，刹停抓住 */
    AVOID_APPROACH,     /* 避障：沿斜角爬回线上 */
    AVOID_SWEEP         /* 避障：兜底扫线（不停车） */
} AvoidAction;

/* ==================== 函数 ==================== */

/* 初始化（内部会调用 HCSR04_Init） */
void Avoid_Init(void);

/* 每个主循环调用一次，返回当前动作 */
AvoidAction Avoid_Update(void);

/* 按当前状态驱动电机。
 * 必须由 main.c 在 __disable_irq()/__enable_irq() 之间调用。 */
void Avoid_ApplyMotion(void);

/* 取当前动作，不刷新状态（显示用） */
AvoidAction Avoid_GetAction(void);

/* 取最近一次的距离读数（厘米，-1 = 无回波 / 超过约 1.37m） */
int16_t Avoid_GetFrontCm(void);
int16_t Avoid_GetLeftCm(void);
int16_t Avoid_GetRightCm(void);

/* 已经触发了多少次避障动作（屏幕显示用 N）：
 * 数字一直涨 = 车在反复触发；不动车却停住 = 停的原因不在避障上。 */
uint32_t Avoid_GetManeuverCount(void);

/* ---------------- main.c 需要提供的"循迹状态副本" ---------------- */
/* 由 TIM1 中断维护：当前压线的通道数（0 = 丢线）。
 * 避障模块靠它判断"回到线了没有"——这样主循环就不必去碰循迹的 GPIO。 */
extern volatile uint8_t g_track_active;

#endif

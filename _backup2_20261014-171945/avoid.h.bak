#ifndef AVOID_H
#define AVOID_H

// 超声波避障状态机
//
// ==================== 设计目标 ====================
// 没有障碍物时，本模块对循迹【零影响】：
//   对外只通过一个动作枚举交接；电机和循迹传感器都不由主循环直接碰。
//
// ==================== 动作序列 ====================
// （障碍物在右侧为例）
//   FOLLOW  循迹中持续测距
//     |  任一侧读数 <= AVOID_TRIGGER_CM(20cm)
//     v
//   BRAKE   刹停（防惯性蹭到，规则要求零接触）
//     |
//     v
//   DODGE   转出：障碍侧轮停、另一侧轮快 -> 往左转 45°
//     |  结束：转够 AVOID_DODGE_PULSES(813) 个脉冲（或超时兜底）
//     v
//   PASS    两轮同速直行（横向绕过去）
//     |  结束：走够 AVOID_PASS_PULSES(1380) 个脉冲（或超时兜底）
//     v
//   RETURN  反方向画弧：刚才停的轮加速、另一轮慢（都不停）
//     |  结束：循迹传感器重新压线（读 g_track_active 副本）
//     v
//   FOLLOW  交回循迹
//   （RETURN 超时 -> SEARCH 继续慢速画弧 -> 再不成功 -> HOLD 停车）
//
// ==================== ⚠ 使用约定（必须遵守，否则会互相干扰）====================
//   1. 本模块【只在主循环】调用，绝不进中断。
//   2. 本模块【不调用任何 Track_xxx 函数】——那些函数会操作 CD4051 的地址线，
//      和 TIM1 中断抢 GPIO，会让循迹读数错乱。循迹状态只读 g_track_active 副本。
//   3. 电机由 Avoid_ApplyMotion() 写，且必须由 main.c 在
//      __disable_irq() / __enable_irq() 之间调用，保证左右轮整组指令原子生效。
//   4. main.c 的中断里必须维护 g_track_active（压线路数副本），
//      且读编码器必须在 g_track_enable 判断【之前】。

#include "main.h"
#include "hcsr04.h"

/* ==================== 探头配置 ==================== */
/* 是否使用中间的 U2 探头（当前没装，保持 0）
 * 装了就把 hcsr04.h 里的 HCSR04_CENTER 用上，并改成 1 */
#define AVOID_USE_CENTER 0

/* ==================== 阈值（厘米） ==================== */
#define AVOID_TRIGGER_CM 20   /* 任一侧 <= 此距离 -> 触发避障 */
#define AVOID_CLEAR_CM   40   /* 前方 <= 此距离但 > 触发值 -> 循迹但减速 */

/* ==================== 采样周期（毫秒） ==================== */
/* 两路轮流测，所以单路约 2 倍这个时间刷新一次 */
#define AVOID_SAMPLE_MS 40

/* ==================== 里程参数（编码器脉冲） ==================== */
/* 换算依据：
 *   轮径 48mm -> 周长 15.08cm；1040 脉冲/圈 -> 69 脉冲/cm
 *   轮距 15cm -> 转 1° 约 18 脉冲
 * 若以后换了轮子或改了减速比，按上面两条重新算。 */
#define AVOID_DODGE_PULSES 813    /* 转出 45°（轮距 15cm） */
#define AVOID_PASS_PULSES  1380   /* 直行 20cm（1 个车长，保证车尾也越过障碍物） */

/* ==================== 各阶段电机 PWM（占空比 0~100） ==================== */
#define AVOID_DODGE_FAST   55     /* 转出：外侧轮（在转的那个） */
#define AVOID_DODGE_SLOW    0     /* 转出：内侧轮（0 = 停住，转弯半径最小） */
#define AVOID_PASS_PWM     35     /* 直行绕过：两轮同速 */
#define AVOID_RETURN_FAST  50     /* 回线：外侧轮快 */
#define AVOID_RETURN_SLOW  22     /* 回线：内侧轮慢（不停，避免顿挫） */
#define AVOID_SEARCH_FAST  30     /* 兜底搜索：更慢的同方向画弧 */
#define AVOID_SEARCH_SLOW  12

/* ==================== 超时兜底（毫秒） ==================== */
#define AVOID_BRAKE_MS     120    /* 刹停保持时间 */
#define AVOID_DODGE_MAX_MS 1500   /* 转出超时（里程判据失效时兜底） */
#define AVOID_PASS_MAX_MS  2500   /* 直行超时 */
#define AVOID_RETURN_MS    1500   /* 回线超时 -> 进搜索 */
#define AVOID_SEARCH_MS    1200   /* 搜索超时 -> 停车 */

/* ==================== 动作枚举 ==================== */
/* 上半部分是"循迹自己能处理"的，下半部分是"避障接管电机"的。
 * main.c 只需要判断 FOLLOW / SLOW 两个值，其余交给 Avoid_ApplyMotion()。 */
typedef enum
{
    AVOID_FOLLOW = 0,   /* 交还给寻迹逻辑（正常循迹） */
    AVOID_SLOW,         /* 循迹，但降低目标速度 */
    AVOID_BRAKE,        /* 避障：刹停 */
    AVOID_DODGE,        /* 避障：转出 */
    AVOID_PASS,         /* 避障：直行绕过 */
    AVOID_RETURN,       /* 避障：画弧回线 */
    AVOID_SEARCH,       /* 避障：兜底搜索 */
    AVOID_HOLD          /* 避障：搜索失败，停车等待 */
} AvoidAction;

/* ==================== 函数 ==================== */

/* 初始化（内部会调用 HCSR04_Init） */
void Avoid_Init(void);

/* 每个主循环调用一次，返回当前动作 */
AvoidAction Avoid_Update(void);

/* 按当前状态驱动电机。
 * ⚠ 必须由 main.c 在 __disable_irq()/__enable_irq() 之间调用。 */
void Avoid_ApplyMotion(void);

/* 取当前动作，不刷新状态（显示用） */
AvoidAction Avoid_GetAction(void);

/* 取最近一次的距离读数（厘米，-1 = 无回波） */
int16_t Avoid_GetFrontCm(void);
int16_t Avoid_GetLeftCm(void);
int16_t Avoid_GetRightCm(void);

/* ---------------- main.c 需要提供的"循迹状态副本" ---------------- */
/* 由 TIM1 中断维护：当前压线的通道数（0 = 丢线）。
 * 避障模块靠它判断"回到线了没有"——这样主循环就不必去碰循迹的 GPIO。 */
extern volatile uint8_t g_track_active;

#endif

#include "avoid.h"

#include <stdlib.h>   /* labs */

#include "encoder.h"  /* encoder_left / encoder_right */
#include "motor.h"    /* Motor_SetSpeed / Motor_BrakeAll */

/* ==================== 状态机 ==================== */
typedef enum
{
    ST_FOLLOW = 0,   /* 循迹，只测距 */
    ST_BRAKE,        /* 刹停 */
    ST_DODGE,        /* 转出（编码器计里程） */
    ST_PASS,         /* 直行绕过（编码器计里程） */
    ST_RETURN        /* 画弧回线（看循迹压线，一直找到为止） */
} AvoidState;

/* 状态机上下文：跨状态必须记住的东西全装在这里。
 * 特别是 side（障碍在哪一侧）——它同时决定"绕行方向"和"回线方向"，
 * 两个方向必须一致，否则永远找不回线。 */
typedef struct
{
    AvoidState state;
    uint32_t   tick;      /* 进入本状态的时刻（超时用） */
    uint8_t    side;      /* 障碍在哪一侧：0 = 未知，1 = 左，2 = 右 */
    int32_t    enc_ref;   /* 进入本状态时的编码器累计值（算里程用） */
    uint8_t    slowing;   /* 减速状态的滞回标志（仅 AVOID_USE_SLOW = 1 时用） */
    uint32_t   rearm_tick;/* 上次"交回循迹"的时刻，用于触发冷却（AVOID_REARM_MS） */
} AvoidCtx;

static AvoidCtx    ctx;
static AvoidAction action = AVOID_FOLLOW;

/* 采样限频 */
static uint32_t sample_tick = 0;
static uint8_t  sample_next = 0;

/* 每个探头"连续读到障碍"的次数（用于 AVOID_CONFIRM 确认，见 avoid.h） */
static uint8_t  hit_streak[HCSR04_ID_COUNT];

/* 已经触发过多少次避障动作（屏幕显示用） */
static uint32_t maneuver_cnt = 0;

/* ==================== 小工具 ==================== */

/* 清空连续命中计数：强制下一次触发重新走一遍"连续确认"。
 * 每次避障动作开始、以及交回循迹时都清一次。 */
static void ClearHits(void)
{
    uint8_t i;

    for (i = 0; i < HCSR04_ID_COUNT; i++)
        hit_streak[i] = 0;
}

/* 记录一次测量结果：命中就累加，没命中就清零。
 * 距离下限 AVOID_MIN_VALID_CM 用来滤掉盲区毛刺（驱动里短回波统一报 2cm）。 */
static void NoteHit(HCSR04_ID id)
{
    const int16_t cm = HCSR04_LastCm(id);

    if (cm >= AVOID_MIN_VALID_CM && cm <= AVOID_TRIGGER_CM)
    {
        if (hit_streak[id] < 250U)
            hit_streak[id]++;
    }
    else
    {
        hit_streak[id] = 0;
    }
}

/* 取距离，-1（无回波）折算成 999（很远） */
static int16_t Cm(HCSR04_ID id)
{
    const int16_t cm = HCSR04_LastCm(id);

    return (cm < 0) ? 999 : cm;
}

/* 正前方距离：取所有可用探头里的最小值。
 * 这样即使中间探头忘了插（读数恒为 -1），左右两路依然兜底。 */
static int16_t FrontCm(void)
{
    int16_t front = -1;
    int16_t cm;

    cm = HCSR04_LastCm(HCSR04_LEFT);
    if (cm > 0 && (front < 0 || cm < front))
        front = cm;

    cm = HCSR04_LastCm(HCSR04_RIGHT);
    if (cm > 0 && (front < 0 || cm < front))
        front = cm;

#if AVOID_USE_CENTER
    cm = HCSR04_LastCm(HCSR04_CENTER);
    if (cm > 0 && (front < 0 || cm < front))
        front = cm;
#endif

    return (front < 0) ? 999 : front;
}

/* 里程用的编码器累计值。
 *
 * 转出阶段是"一个轮停、另一个轮转"，所以要读【在转的那个轮】；
 * 直行阶段两轮都转，读左轮即可。
 *
 * 注意：累计值只取绝对值 —— 左轮编码器装了反向修正（ENC_LEFT_INVERT），
 * 正向行驶时它的 total_count 是在减小的，我们只关心"走了多远"。 */
static int32_t EncUsed(void)
{
    if (ctx.state == ST_DODGE)
    {
        /* 障碍在右(side=2) -> 左轮停、右轮转 -> 读右轮
         * 障碍在左(side=1) -> 右轮停、左轮转 -> 读左轮 */
        return (ctx.side == 2) ? encoder_right.total_count
                               : encoder_left.total_count;
    }

    return encoder_left.total_count;
}

/* 进入一个新状态（同时记录时间戳和编码器起点） */
static void Enter(AvoidState s)
{
    ctx.state = s;
    ctx.tick  = HAL_GetTick();

    /* 注意：必须先设 state 再取 EncUsed()，因为 EncUsed 依赖 state */
    ctx.enc_ref = EncUsed();
}

/* 轮流采样：每 AVOID_SAMPLE_MS 只测一路，单个探头最坏阻塞 8ms，
 * 主循环不会被长时间占住。这个函数【只能】在主循环里调用。 */
static void Avoid_Sample(void)
{
    HCSR04_ID id;

    if ((HAL_GetTick() - sample_tick) < AVOID_SAMPLE_MS)
        return;

    sample_tick = HAL_GetTick();

#if AVOID_USE_CENTER
    if (sample_next == 0)
    {
        id = HCSR04_CENTER;
        sample_next = 1;
    }
    else if (sample_next == 1)
    {
        id = HCSR04_LEFT;
        sample_next = 2;
    }
    else
    {
        id = HCSR04_RIGHT;
        sample_next = 0;
    }
#else
    if (sample_next == 0)
    {
        id = HCSR04_LEFT;
        sample_next = 1;
    }
    else
    {
        id = HCSR04_RIGHT;
        sample_next = 0;
    }
#endif

    HCSR04_ReadCm(id);
    NoteHit(id);
}

/* ==================== 初始化 ==================== */

void Avoid_Init(void)
{
    HCSR04_Init();

    ctx.state   = ST_FOLLOW;
    ctx.tick    = HAL_GetTick();
    ctx.side    = 0;
    ctx.enc_ref = EncUsed();
    ctx.slowing = 0;
    ctx.rearm_tick = HAL_GetTick() - AVOID_REARM_MS;  /* 上电即可触发，不冷却 */

    ClearHits();
    maneuver_cnt = 0;

    action      = AVOID_FOLLOW;
    sample_tick = HAL_GetTick();
    sample_next = 0;
}

/* ==================== 状态机主体 ==================== */

AvoidAction Avoid_Update(void)
{
    Avoid_Sample();

    switch (ctx.state)
    {
    /* ---------------- 循迹：只测距，不碰电机 ---------------- */
    case ST_FOLLOW:
    {
        /* 冷却期内不再触发：刚绕完障碍回到线上时车还贴着障碍物，
         * 不复位的话会"刚回线就刹车 -> 又转出去"，走一段停一下。 */
        const uint8_t rearmed =
            ((HAL_GetTick() - ctx.rearm_tick) >= AVOID_REARM_MS);

        /* 用"连续确认过"的命中，而不是单次读数：
         * 超声波偶尔蹦一个假回波，不能让车因此拐出去。 */
        const uint8_t l_hit = (hit_streak[HCSR04_LEFT]  >= AVOID_CONFIRM);
        const uint8_t r_hit = (hit_streak[HCSR04_RIGHT] >= AVOID_CONFIRM);

        if (AVOID_ENABLE && rearmed && (l_hit || r_hit))
        {
            /* 两侧都确认到 -> 取更近的一侧；只有一侧 -> 就是那一侧 */
            if (l_hit && r_hit)
                ctx.side = (Cm(HCSR04_LEFT) <= Cm(HCSR04_RIGHT)) ? 1 : 2;
            else
                ctx.side = l_hit ? 1 : 2;

            ClearHits();     /* 下一次触发要重新连续确认 */
            maneuver_cnt++;  /* 记一笔，屏幕上看得到（N） */

            Enter(ST_BRAKE);
            action = AVOID_BRAKE;
        }
#if AVOID_USE_SLOW
        /* 带滞回：进门槛低、退出门槛高，防止在门槛附近来回跳 */
        else if (ctx.slowing ? (FrontCm() <= AVOID_SLOW_OUT_CM)
                             : (FrontCm() <= AVOID_SLOW_IN_CM))
        {
            ctx.slowing = 1;
            action = AVOID_SLOW;
        }
        else
        {
            ctx.slowing = 0;
            action = AVOID_FOLLOW;
        }
#else
        else
        {
            action = AVOID_FOLLOW;  /* 默认：除了避障，一律正常循迹 */
        }
#endif
        break;
    }

    /* ---------------- 刹停：先停稳，防惯性蹭到 ---------------- */
    case ST_BRAKE:
        if ((HAL_GetTick() - ctx.tick) >= AVOID_BRAKE_MS)
            Enter(ST_DODGE);

        action = AVOID_BRAKE;
        break;

    /* ---------------- 转出：转到偏离原方向 45° ---------------- */
    case ST_DODGE:
    {
        const int32_t moved   = labs(EncUsed() - ctx.enc_ref);
        const uint8_t timeout = ((HAL_GetTick() - ctx.tick) >= AVOID_DODGE_MAX_MS);

        if ((moved >= AVOID_DODGE_PULSES) || timeout)
            Enter(ST_PASS);

        action = AVOID_DODGE;
        break;
    }

    /* ---------------- 直行绕过：让车尾也越过障碍物 ---------------- */
    case ST_PASS:
    {
        const int32_t moved   = labs(EncUsed() - ctx.enc_ref);
        const uint8_t timeout = ((HAL_GetTick() - ctx.tick) >= AVOID_PASS_MAX_MS);

        if ((moved >= AVOID_PASS_PULSES) || timeout)
            Enter(ST_RETURN);

        action = AVOID_PASS;
        break;
    }

    /* ---------------- 画弧回线：扫到线就交回循迹；扫不到就一直找 ----------------
     * 注意：这里【绝不主动停车】。比赛里停下来等于放弃，
     *       宁可一直画弧找线（时间到了只是把转向加急一点）。 */
    case ST_RETURN:
        if (g_track_active > 0)
        {
            action = AVOID_FOLLOW;   /* 先给出"交回"的动作，再切状态 */
            ctx.rearm_tick = HAL_GetTick();  /* 交回后进入冷却，先正常走一段 */
            ClearHits();                     /* 下一次触发重新确认 */
            Enter(ST_FOLLOW);
        }
        else
        {
            action = AVOID_RETURN;
        }
        break;

    default:
        action = AVOID_FOLLOW;
        break;
    }

    return action;
}

/* ==================== 电机输出 ==================== */
/*
 * ⚠ 本函数【必须】由 main.c 在 __disable_irq()/__enable_irq() 之间调用，
 *    否则左右两条 Motor_SetSpeed 之间可能被 TIM1 中断插入，
 *    出现"左轮避障值 + 右轮循迹值"的混合状态，车会猛抽一下。
 */
void Avoid_ApplyMotion(void)
{
    int16_t l = 0;
    int16_t r = 0;
    uint8_t drive = 1;

    switch (ctx.state)
    {
    /* 刹停：直接短接制动 */
    case ST_BRAKE:
        Motor_BrakeAll();
        return;

    /* 转出：障碍侧轮停(慢)，另一侧轮快
     *   障碍在右(side=2) -> 往左转 -> 右轮快、左轮停
     *   障碍在左(side=1) -> 往右转 -> 左轮快、右轮停 */
    case ST_DODGE:
        if (ctx.side == 1)
        {
            l = AVOID_DODGE_FAST;
            r = AVOID_DODGE_SLOW;
        }
        else
        {
            l = AVOID_DODGE_SLOW;
            r = AVOID_DODGE_FAST;
        }
        break;

    /* 直行绕过：两轮同速 */
    case ST_PASS:
        l = AVOID_PASS_PWM;
        r = AVOID_PASS_PWM;
        break;

    /* 回线：与转出方向【相反】，且两轮都不停
     *   障碍在右(side=2) -> 转出时右轮快，现在左轮快、右轮慢
     *   障碍在左(side=1) -> 转出时左轮快，现在右轮快、左轮慢
     * 第一段走 AVOID_RETURN_MS 之后，自动切到更急的第二段继续找。 */
    case ST_RETURN:
    {
        const uint8_t urgent = ((HAL_GetTick() - ctx.tick) >= AVOID_RETURN_MS);
        const int16_t fast = urgent ? AVOID_RETURN_FAST2 : AVOID_RETURN_FAST;
        const int16_t slow = urgent ? AVOID_RETURN_SLOW2 : AVOID_RETURN_SLOW;

        if (ctx.side == 1)
        {
            l = slow;
            r = fast;
        }
        else
        {
            l = fast;
            r = slow;
        }
        break;
    }

    /* 循迹状态：本函数不该被调用 */
    default:
        drive = 0;
        break;
    }

    if (!drive)
        return;

    Motor_SetSpeed(MOTOR_LEFT,  MOTOR_START, l);
    Motor_SetSpeed(MOTOR_RIGHT, MOTOR_START, r);
}

/* ==================== 对外查询 ==================== */

AvoidAction Avoid_GetAction(void)
{
    return action;
}

int16_t Avoid_GetFrontCm(void)
{
    return FrontCm();
}

int16_t Avoid_GetLeftCm(void)
{
    return HCSR04_LastCm(HCSR04_LEFT);
}

int16_t Avoid_GetRightCm(void)
{
    return HCSR04_LastCm(HCSR04_RIGHT);
}

uint32_t Avoid_GetManeuverCount(void)
{
    return maneuver_cnt;
}
